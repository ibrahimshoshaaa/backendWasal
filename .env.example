# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# Railway بيوفر متغير DATABASE_URL تلقائياً عند ربط قاعدة Postgres بالخدمة.
DATABASE_URL=

# ─── JWT ──────────────────────────────────────────────────────────────────────
# نص عشوائي طويل وسري. غيّره لأي قيمة قوية على Railway.
JWT_SECRET=

# ─── Server ───────────────────────────────────────────────────────────────────
# Railway بيحقن PORT تلقائياً — ما تحطش قيمة هنا في الإنتاج.
PORT=3000

# ─── Cloudinary (رفع الصور) ───────────────────────────────────────────────────
# القيم دي هتاخدها من Dashboard حساب Cloudinary بتاعك:
#   https://console.cloudinary.com/  →  Dashboard  →  Account Details
# لا ترفع القيم الحقيقية على GitHub أبداً — حطها في Railway Variables فقط.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Firebase Cloud Messaging (إشعارات Push للموبايل) ─────────────────────────
# محتوى ملف الـ Service Account JSON كله في سطر واحد (JSON مضغوط).
# من: Firebase Console → Project settings → Service accounts → Generate new private key
# لو سيبته فاضي، السيرفر يشتغل عادي بس من غير Push.
FIREBASE_SERVICE_ACCOUNT=
